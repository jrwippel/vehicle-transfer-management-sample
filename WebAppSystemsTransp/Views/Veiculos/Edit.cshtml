@model WebAppSystemsTransp.Models.Veiculo

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Veículo</h4>
<hr />
<div class="row">
    <div class="col-md-6 col-sm-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ModeloId" class="control-label"></label>
                <select asp-for="ModeloId" class="form-control" asp-items="@(ViewBag.Modelos ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                    <option value="">Selecione um modelo...</option>
                </select>
                <span asp-validation-for="ModeloId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Matricula" class="control-label"></label>
                <input asp-for="Matricula" class="form-control" />
                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model WebAppSystemsTransp.Models.Veiculo

@{
    ViewData["Title"] = "Cadastrar Veículo";
}

<h1>Cadastrar Veículo</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <!-- Marca (Dropdown) -->
            <div class="form-group">
                <label asp-for="ModeloId" class="control-label">Marca</label>
                <select id="MarcaDropdown" class="form-control" name="MarcaId">
                    <option value="">Selecione uma marca...</option>
                    @foreach (var marca in ViewBag.Marcas as SelectList)
                    {
                        <option value="@marca.Value">@marca.Text</option>
                    }
                </select>
                <span asp-validation-for="ModeloId" class="text-danger"></span>
            </div>

            <!-- Modelo (Dropdown) - será preenchido dinamicamente -->
            <div class="form-group">
                <label asp-for="ModeloId" class="control-label">Modelo</label>
                <select asp-for="ModeloId" class="form-control" id="ModeloDropdown">
                    <option value="">Selecione um modelo...</option>
                </select>
                <span asp-validation-for="ModeloId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Matricula" class="control-label">Matrícula</label>
                <input asp-for="Matricula" class="form-control" />
                <span asp-validation-for="Matricula" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Cadastrar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var marcaDropdown = document.getElementById("MarcaDropdown");
            var modeloDropdown = document.getElementById("ModeloDropdown");

            marcaDropdown.addEventListener("change", function () {
                var marcaId = marcaDropdown.value;

                console.log('Marca selecionada:', marcaId);

                if (!marcaId) {
                    modeloDropdown.innerHTML = '<option value="">Selecione um modelo...</option>';
                    return;
                }

                // Faz a requisição para obter os modelos baseados na marca selecionada
                $.get('/Veiculos/GetModelosPorMarca', { marcaId }, function (data) {
                    console.log("Modelos recebidos:", data);

                    modeloDropdown.innerHTML = '<option value="">Selecione um modelo...</option>';

                    data.forEach(function (modelo) {
                        var option = document.createElement("option");
                        option.value = modelo.id;
                        option.text = modelo.nome;
                        modeloDropdown.appendChild(option);
                    });
                }).fail(function (error) {
                    console.error("Erro ao buscar modelos:", error);
                });
            });
        });
        ;
    </script>
}


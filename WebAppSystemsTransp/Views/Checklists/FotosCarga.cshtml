@model IEnumerable<WebAppSystemsTransp.Models.Dto.FotoDto>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fotos do Pedido</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-4">
        <h1 class="text-center">Fotos do Pedido</h1>

        <!-- Listagem de Fotos -->
        @if (Model == null || !Model.Any())
        {
            <p class="text-muted text-center">Nenhuma foto cadastrada.</p>
        }
        else
        {
            <div class="row">
                @foreach (var foto in Model)
                {
                    <div class="col-4 mb-3">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <!-- Tipo da foto no cabeçalho -->
                                <h5>@foto.TipoFoto</h5>
                                <img src="/images/icon.png" alt="Ícone" class="img-fluid ms-auto" style="height: 20px; width: 20px;" />
                            </div>
                            <img src="@foto.UrlFoto" class="card-img-top" alt="Foto">
                            <div class="card-body">
                                <p class="card-text">
                                    <a href="#" onclick="downloadAndViewPhoto('@foto.Id')" class="text-decoration-none text-primary" style="font-size: 0.875rem;">
                                        Nome: @foto.NomeArquivo
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Modal para Visualização da Foto -->
    <div class="modal fade" id="photoViewModal" tabindex="-1" aria-labelledby="photoViewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="photoViewModalLabel">Visualizar Foto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="photoPreview" class="img-fluid" alt="Foto Visualizada">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Função para baixar e visualizar a foto
        async function downloadAndViewPhoto(fotoId) {
            try {
                const response = await fetch(`/Checklists/DownloadFotoPedido/${fotoId}`);
                if (!response.ok) {
                    alert("Erro ao baixar a foto.");
                    return;
                }
                const blob = await response.blob(); // Obter o conteúdo da imagem
                const url = URL.createObjectURL(blob); // Criar URL para visualizar

                // Exibir a imagem no modal
                const photoPreview = document.getElementById("photoPreview");
                photoPreview.src = url;

                const photoModal = new bootstrap.Modal(document.getElementById("photoViewModal"));
                photoModal.show();
            } catch (error) {
                alert("Erro de conexão ao tentar visualizar a foto.");
            }
        }
    </script>
</body>
</html>

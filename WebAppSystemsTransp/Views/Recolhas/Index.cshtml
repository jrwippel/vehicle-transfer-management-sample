@model IEnumerable<WebAppSystemsTransp.Models.ViewModels.PedidoViewModel>

@{
    ViewData["Title"] = "Checklist de Veículo";
}

<style>
    .card-checklist {
        margin: 20px auto;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
        max-width: 700px; /* Limitar a largura */
    }

    .field-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

        .field-container input,
        .field-container select {
            flex: 1;
            margin-left: 10px;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            position: relative;
        }

            .field-container input:focus,
            .field-container select:focus {
                border-color: #007bff;
                outline: none;
            }

        .field-container i {
            font-size: 18px;
            color: #007bff;
            position: absolute;
            margin-left: -24px;
            pointer-events: none;
        }

    .switch-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
        padding: 10px 0;
    }

        .switch-container label {
            font-size: 16px;
            font-weight: bold;
            flex: 1;
            margin-left: 10px;
        }

        .switch-container input[type="checkbox"] {
            width: 20px;
            height: 20px;
        }
</style>

<div class="container">
    <div class="card-checklist">
        <h3 class="text-center">@ViewData["Title"]</h3>
        <hr />

        <!-- Campo de Hora Inicial -->
        <div class="field-container">
            <label for="horaInicial">Hora Início</label>
            <i class="fas fa-clock"></i>
            <input id="horaInicial" type="text" class="form-control" value="@DateTime.Now.ToString("HH:mm:ss")" readonly>
        </div>

        <!-- Campo de KM Inicial -->
        <div class="field-container">
            <label for="kmInicial">KM Inicial</label>
            <i class="fas fa-tachometer-alt"></i>
            <input id="kmInicial" type="number" class="form-control" placeholder="Informe o KM Inicial">
        </div>

        <!-- Combo de Combustível -->
        <div class="field-container">
            <label for="combustivelInicial">Combustível Inicial</label>
            <i class="fas fa-gas-pump"></i>
            <select id="combustivelInicial" class="form-control">
                <option value="0">Selecionar</option>
                <option value="1">Reserva</option>
                <option value="2">1/4</option>
                <option value="3">Meio</option>
                <option value="4">3/4</option>
                <option value="5">Cheio</option>
                <option value="6">Abastecimento</option>
            </select>
        </div>

        <hr />

        <!-- Itens de Verificação -->
        <h4>Itens de Verificação</h4>

        <div class="switch-container">
            <input type="checkbox" id="trianguloHomologado">
            <label for="trianguloHomologado">
                <i class="fas fa-warning text-warning"></i> Triângulo Homologado
            </label>
        </div>

        <div class="switch-container">
            <input type="checkbox" id="coleteHomologado">
            <label for="coleteHomologado">
                <i class="fas fa-vest text-secondary"></i> Colete Homologado
            </label>
        </div>

        <div class="switch-container">
            <input type="checkbox" id="documentoSeguro">
            <label for="documentoSeguro">
                <i class="fas fa-file-alt text-primary"></i> Documento Seguro
            </label>
        </div>

        <div class="switch-container">
            <input type="checkbox" id="documentoVeiculo">
            <label for="documentoVeiculo">
                <i class="fas fa-file text-success"></i> Documento Veículo
            </label>
        </div>

        <hr />
        <!-- Botão para Salvar -->
        <div class="text-center">
            <button type="button" class="btn btn-primary">Salvar Checklist</button>
        </div>
    </div>
</div>

<script>
    // Atualizar Hora em Tempo Real
    setInterval(function () {
        const now = new Date();
        document.getElementById('horaInicial').value = now.toLocaleTimeString('pt-BR');
    }, 1000);
</script>

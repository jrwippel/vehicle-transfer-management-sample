@model WebAppSystemsTransp.Models.Pedido

@{
    ViewData["Title"] = "Recolha - Editar Execução";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit">
    <div class="form-group">
        <label asp-for="DataExecucao" class="control-label"></label>
        <input asp-for="DataExecucao" class="form-control" type="date" />
        <span asp-validation-for="DataExecucao" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HoraInicio" class="control-label"></label>
        <input asp-for="HoraInicio" class="form-control" type="time" value="@Model.HoraInicio?.ToString("hh\\:mm")" />
        <span asp-validation-for="HoraInicio" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="HoraFinal" class="control-label"></label>
        <input asp-for="HoraFinal" class="form-control" type="time" value="@Model.HoraFinal?.ToString("hh\\:mm")" />
        <span asp-validation-for="HoraFinal" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
</form>

<a href="@Url.Action("Index", "Recolhas")" class="btn btn-secondary">Voltar para Listagem</a>

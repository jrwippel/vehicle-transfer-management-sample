@model IEnumerable<WebAppSystemsTransp.Models.ViewModels.PedidoViewModel>

@{

    ViewData["Title"] = "Recolhas";
}


<style>

    /* Estilos gerais */
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f7f7f7;
        margin: 0;
        font-size: 16px; /* Aumentar o tamanho da fonte */
    }

    /* Modal */
    #photoModal .modal-content {
        width: 90%;
        max-width: 375px;
        margin: auto;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    /* Vídeo e Canvas */
    #photoModal video, #photoModal canvas {
        width: 100%;
        max-height: 250px;
        border-radius: 15px;
    }

    /* Botões */
    .btn {
        border-radius: 30px;
        padding: 10px 20px;
        font-size: 14px;
        display: inline-block;
        min-width: 50px;
        margin: 5px 0;
        transition: background-color 0.3s ease; /* Transição suave */
    }

    .btn-play {
        background-color: #28a745;
        color: white;
    }

    .btn-stop {
        background-color: #dc3545;
        color: white;
    }

    .btn-photo {
        background-color: #007bff;
        color: white;
    }

    .btn i {
        font-size: 18px;
    }

    /* Tabela */
    .table {
        width: 100%;
        background-color: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    table thead {
        background-color: #343a40;
        color: white;
        font-size: 14px;
    }

    table tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    table tbody tr:nth-child(odd) {
        background-color: #e9ecef;
    }

    table tbody tr td {
        font-size: 14px;
        padding: 12px 10px;
        vertical-align: middle;
    }

    /* Cartão de conteúdo */
    .card-body {
        padding: 20px;
        border-radius: 20px;
        background-color: #ffffff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    /* Espaçamento do título */
    .card-title {
        font-size: 18px;
        margin-bottom: 20px;
    }

    /* Estilos de Formulário */
    .form-select {
        width: 100%;
        font-size: 14px;
        height: 2.5rem;
        margin-bottom: 10px;
        border-radius: 10px;
    }

    /* Alinhar os ícones na horizontal */
    .action-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .action-buttons button {
            margin: 0 10px;
        }

</style>

<div class="modal fade" id="modalDetalhes" tabindex="-1" aria-labelledby="modalDetalhesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalhesLabel">Detalhes do Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>                
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <th>ID do Pedido</th>
                            <td id="det-id"></td>
                        </tr>
                        <tr>
                            <th>Placa do Veículo</th>
                            <td id="det-placa"></td>
                        </tr>
                        <tr>
                            <th>Modelo</th>
                            <td id="det-modelo"></td>
                        </tr>
                        <tr>
                            <th>Cliente de Carga</th>
                            <td id="det-clienteCarga"></td>
                        </tr>
                        <tr>
                            <th>Endereço de Carga</th>
                            <td id="det-enderecoCarga"></td>
                        </tr>
                        <tr>
                            <th>Cliente de Descarga</th>
                            <td id="det-clienteDescarga"></td>
                        </tr>
                        <tr>
                            <th>Endereço de Descarga</th>
                            <td id="det-enderecoDescarga"></td>
                        </tr>
                        <tr>
                            <th>Tipo do Pedido</th>
                            <td id="det-tipo"></td>
                        </tr>
                        <tr>
                            <th>Informações Carga</th>
                            <td id="det-inf-carga"></td>
                        </tr>
                        <tr>
                            <th>Informações Descarga</th>
                            <td id="det-inf-descarga"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">                
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>

        </div>
    </div>
</div>


<div class="card">
    <div class="card-body">
        <h4 class="card-title">Recolhas</h4>
        <hr />
        <table class="table" id="table-SearchRecord">
            <thead>
                <tr class="w-100">
                    <th>ID</th>
                    <th>Detalhes</th>
                    <th>Fotos</th>
                    <th>Recolha</th>
                    <th>Entrega</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    <tr>
                        <td data-label="ID">@pedido.Id</td>
                        <td data-label="Detalhes">
                            <button class="btn btn-secondary btn-detalhes btn-sm" data-id="@pedido.Id">
                                <i class="fas fa-info-circle fa-xs"></i>
                            </button>
                        </td>

                        <td data-label="Foto Recolha">
                            <button class="btn btn-primary btn-photo btn-sm" data-id="@pedido.Id">
                                <i class="fas fa-camera fa-xs"></i>
                            </button>
                        </td>
                        <td data-label="Recolha">
                            <button class="btn btn-success btn-play btn-sm"
                                    data-id="@pedido.Id"
                            @(pedido.HoraInicio != null || !pedido.PossuiTodasFotosCarga ? "disabled" : "")>
                                <i class="fas fa-play fa-xs"></i>
                            </button>
                        </td>
                        <td data-label="Entrega">
                            <button class="btn btn-danger btn-stop btn-sm"
                                    data-id="@pedido.Id"
                            @(pedido.HoraInicio == null || pedido.HoraFinal != null || !pedido.PossuiTodasFotosDescarga ? "disabled" : "")>
                                <i class="fas fa-stop fa-xs"></i>
                            </button>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalRecolha" tabindex="-1" aria-labelledby="modalRecolhaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalRecolhaLabel">Iniciando a Recolha</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Abas -->
                <ul class="nav nav-tabs" id="recolhaTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="gerais-tab" data-bs-toggle="tab" data-bs-target="#gerais" type="button" role="tab">Checklist</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="assinaturaMotorista-tab" data-bs-toggle="tab" data-bs-target="#assinaturaMotorista" type="button" role="tab">Motorista</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="assinaturaCliente-tab" data-bs-toggle="tab" data-bs-target="#assinaturaCliente" type="button" role="tab">Cliente</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="dadosGerais-tab" data-bs-toggle="tab" data-bs-target="#dadosGeraisRec" type="button" role="tab">Gerais</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="avarias-tab" data-bs-toggle="tab" data-bs-target="#avarias" type="button">Avarias</button>
                    </li>
                </ul>

                <!-- Conteúdo das abas -->
                <div class="tab-content mt-3" id="recolhaTabContent">
                    <!-- Aba innfo -->
                    <div class="tab-pane fade show active" id="gerais" role="tabpanel">
                        <form id="startForm">
                            <div class="mb-3">
                                <label for="kmInicial" class="form-label">KM Inicial</label>
                                <input type="number" step="0.001" class="form-control" id="kmInicial" name="kmInicial" required />
                            </div>

                            <div class="mb-3">
                                <select class="form-select" id="combustivelInicial" name="combustivelInicial" required>
                                    <option value="" disabled selected>Selecione o nível de combustível...</option>
                                    <option value="1">Reserva</option>
                                    <option value="2">1/4</option>
                                    <option value="3">1/2</option>
                                    <option value="4">3/4</option>
                                    <option value="5">Cheio (F)</option>
                                    <option value="6">Abastecimento</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <select class="form-select" id="trianguloHomologado" name="trianguloHomologado" required>
                                    <option value="" disabled selected>Selecione se o triângulo está homologado...</option>
                                    <option value="1">Sim</option>
                                    <option value="2">Não</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <select class="form-select" id="coleteHomologado" name="coleteHomologado" required>
                                    <option value="" disabled selected>Selecione se o colete está homologado...</option>
                                    <option value="1">Sim</option>
                                    <option value="2">Não</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <select class="form-select" id="documentoVeiculo" name="documentoVeiculo" required>
                                    <option value="" disabled selected>Selecione se o documento do veículo está disponível...</option>
                                    <option value="1">Sim</option>
                                    <option value="2">Não</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <select class="form-select" id="documentoSeguro" name="documentoSeguro" required>
                                    <option value="" disabled selected>Selecione se o documento do seguro está disponível...</option>
                                    <option value="1">Sim</option>
                                    <option value="2">Não</option>
                                </select>
                            </div>
                        </form>
                    </div>

                    <!-- Aba Assinatura Motorista -->
                    <div class="tab-pane fade" id="assinaturaMotorista" role="tabpanel">
                        <div class="mb-3">
                            <canvas id="signatureCanvasRecMotorista" width="400" height="200" style="border: 1px solid black;"></canvas>
                            <button type="button" id="clearCanvasMotorista" class="btn btn-secondary mt-2">Limpar Assinatura</button>
                        </div>
                    </div>

                    <!-- Aba Assinatura Cliente -->
                    <div class="tab-pane fade" id="assinaturaCliente" role="tabpanel">
                        <div class="mb-3">
                            <canvas id="signatureCanvasRecCliente" width="400" height="200" style="border: 1px solid black;"></canvas>
                            <button type="button" id="clearCanvasCliente" class="btn btn-secondary mt-2">Limpar Assinatura</button>
                        </div>
                    </div>

                    <!-- Aba Gerais -->
                    <div class="tab-pane fade" id="dadosGeraisRec" role="tabpanel">
                        <form id="startForm">
                            <!-- Campo para Observação da Carga -->
                            <div class="mb-3">
                                <label for="observacaoCarga" class="form-label">Observações</label>
                                <input type="text" class="form-control" id="observacaoCarga" name="observacaoCarga" required />
                            </div>
                            <!-- Campo para Tempo de Espera da Carga -->
                            <div class="mb-3">
                                <label for="tempoEsperaCarga" class="form-label">Tempo de Espera (hh:mm)</label>
                                <input type="time" class="form-control" id="tempoEsperaCarga" name="tempoEsperaCarga" step="60" />
                            </div>
                            <div class="mb-3">
                                <label for="nomePessoaCar" class="form-label">Nome Responsável </label>
                                <input type="text" class="form-control" id="nomePessoaCar" name="nomePessoaCar" required />
                            </div>
                            <div class="mb-3">
                                <label for="emailPessoaCar" class="form-label">Email</label>
                                <input type="text" class="form-control" id="emailPessoaCar" name="emailPessoaCar" required />
                            </div>
                            <div class="mb-3">
                                <label for="telPessoaCar" class="form-label">Telefone</label>
                                <input type="text" class="form-control" id="telPessoaCar" name="telPessoaCar" required />
                            </div>
                        </form>
                    </div>
                    <!-- Aba Avarias -->
                    <div class="tab-pane fade" id="avarias">
                        <div id="imageContainer" style="position: relative; width: 500px; height: 300px;">
                            <img id="avariasImage" src="/images/avarias.png" class="img-fluid"
                                 alt="Imagem de Avarias" style="width: 500px; height: 300px;">
                        </div>
                    </div>

                </div>
            </div>
            <!-- Rodapé do modal -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveStart">Salvar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEntrega" tabindex="-1" aria-labelledby="modalEntregaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <input type="hidden" id="kmInicial">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEntregaLabel">Finalizando a Entrega</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Abas -->
                <ul class="nav nav-tabs" id="entregaTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="km-tab" data-bs-toggle="tab" data-bs-target="#km" type="button">Checklist</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="assinatura-cliente-tab" data-bs-toggle="tab" data-bs-target="#assinatura-cliente" type="button">Cliente</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="assinatura-motorista-tab" data-bs-toggle="tab" data-bs-target="#assinatura-motorista" type="button">Motorista</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="dadosGeraisEnt-tab" data-bs-toggle="tab" data-bs-target="#dadosGeraisEnt" type="button">Gerais</button>
                    </li>

                </ul>

                <div class="tab-content mt-3">
                    <!-- Aba KM Final -->
                    <div class="tab-pane fade show active" id="km">
                        <form id="startForm">

                            <div class="mb-3">
                                <label for="kmFinal" class="form-label">KM Final</label>
                                <input type="number" step="0.001" class="form-control" id="kmFinal" name="kmFinal" required />
                            </div>
                            <div class="mb-3">
                                <select class="form-select" id="combustivelFinal" name="combustivelFinal" required>
                                    <option value="" disabled selected>Selecione o nível de combustível...</option>
                                    <option value="1">Reserva</option>
                                    <option value="2">1/4</option>
                                    <option value="3">1/2</option>
                                    <option value="4">3/4</option>
                                    <option value="5">Cheio (F)</option>
                                </select>
                            </div>
                        </form>
                    </div>

                    <!-- Aba Assinatura Cliente -->
                    <div class="tab-pane fade" id="assinatura-cliente">
                        <div class="mb-3">
                            <canvas id="signatureCanvasEntCliente" width="400" height="200" style="border: 1px solid black;"></canvas>
                            <button type="button" id="clearCanvasCliente" class="btn btn-secondary mt-2">Limpar Assinatura</button>
                        </div>
                    </div>

                    <!-- Aba Assinatura Motorista -->
                    <div class="tab-pane fade" id="assinatura-motorista">
                        <div class="mb-3">
                            <canvas id="signatureCanvasEntMotorista" width="400" height="200" style="border: 1px solid black;"></canvas>
                            <button type="button" id="clearCanvasMotorista" class="btn btn-secondary mt-2">Limpar Assinatura</button>
                        </div>
                    </div>

                    <!-- Aba Gerais -->
                    <div class="tab-pane fade" id="dadosGeraisEnt">
                        <form id="startForm">
                            <div class="mb-3">
                                <label for="observacaoDescarga" class="form-label">Observações</label>
                                <input type="text" class="form-control" id="observacaoDescarga" name="observacaoDescarga" required />
                            </div>
                            <div class="mb-3">
                                <label for="tempoEsperaDescarga" class="form-label">Tempo de Espera (hh:mm)</label>
                                <input type="time" class="form-control" id="tempoEsperaDescarga" name="tempoEsperaDescarga" step="60" />
                            </div>
                            <div class="mb-3">
                                <label for="nomePessoaDes" class="form-label">Nome Responsável </label>
                                <input type="text" class="form-control" id="nomePessoaDes" name="nomePessoaDes" required />
                            </div>
                            <div class="mb-3">
                                <label for="emailPessoaDes" class="form-label">Email</label>
                                <input type="text" class="form-control" id="emailPessoaDes" name="emailPessoaDes" required />
                            </div>
                            <div class="mb-3">
                                <label for="telPessoaDes" class="form-label">Telefone</label>
                                <input type="text" class="form-control" id="telPessoaDes" name="telPessoaDes" required />
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="saveStop">Salvar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoModalLabel">Captura de Foto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Campo oculto para armazenar o PedidoId -->
                <input type="hidden" id="pedidoId">

                <!-- Seleção do Tipo de Foto (Será preenchido dinamicamente com AJAX) -->
                <div id="photoTypeSelection">
                    <h5>Selecione o Tipo de Foto</h5>
                    <select id="photoType" class="form-select">
                        <option value="">-- Selecione --</option>
                    </select>
                </div>

                <!-- Câmera e Captura -->
                <div id="cameraContainer">
                    <video id="video" width="100%" height="auto" autoplay></video>
                    <button id="galleryButton" class="btn btn-primary mt-2">Selecionar Fotos</button>
                    <input type="file" id="galleryInput" accept="image/*" style="display: none;">
                    <canvas id="canvas" style="display:none;"></canvas>
                </div>

                <div id="photoPreview" class="mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>

    <script>
        console.log("Script carregado");

        document.getElementById("avariasImage").addEventListener("click", function (event) {
            let container = document.getElementById("imageContainer");

            // Captura a posição do clique em relação à imagem
            let x = event.offsetX;
            let y = event.offsetY;

            // Criar um select com as opções de avaria
            let select = document.createElement("select");
            select.innerHTML = `
                                <option value="" disabled selected>Selecione...</option>
                                <option value="Falta">Falta</option>
                                <option value="Riscos">Riscos</option>
                                <option value="Mossas">Mossas</option>
                                <option value="Partido">Partido</option>
                                <option value="Naofunciona">Não funciona</option>
                            `;
            select.classList.add("form-select", "form-select-sm");

            // Criar um marcador (div) para conter o select
            let marker = document.createElement("div");
            marker.classList.add("marker");
            marker.style.position = "absolute";
            marker.style.left = `${x}px`;
            marker.style.top = `${y}px`;
            marker.style.transform = "translate(-50%, -50%)";
            marker.style.zIndex = "1000";

            // Adiciona um botão para remover a marcação
            let removeButton = document.createElement("button");
            removeButton.innerHTML = "X";
            removeButton.classList.add("btn", "btn-danger", "btn-sm", "ms-2");

            // Adiciona um título ao botão "X" com o tipo de avaria
            removeButton.title = "Escolha o tipo de avaria";

            // Adiciona evento de "change" no select para ocultar a caixa depois da seleção
            select.addEventListener("change", function () {
                // Atualiza o título do botão com o tipo de avaria selecionado
                removeButton.title = `${select.value}`;
                select.style.display = "none"; // Esconde o select após a seleção
            });

            // Adiciona evento de "click" para remover a marcação
            removeButton.onclick = function () {
                marker.remove();
            };

            // Adiciona os elementos ao marcador e ao container
            marker.appendChild(select);
            marker.appendChild(removeButton);
            container.appendChild(marker);
        });



        $('#photoModal').on('hidden.bs.modal', function () {
            location.reload(); // Recarrega a página
        });

        function clearCanvas(canvasId) {
            var canvas = document.getElementById(canvasId);
            var ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        document.getElementById("clearCanvasMotorista").addEventListener("click", function () {
            clearCanvas("signatureCanvasRecMotorista");
        });

        document.getElementById("clearCanvasCliente").addEventListener("click", function () {
            clearCanvas("signatureCanvasRecCliente");
        });

        function formatKM(input) {
            let value = input.value.replace(/\D/g, ""); // Remove caracteres não numéricos
            value = value.replace(/\B(?=(\d{3})+(?!\d))/g, "."); // Adiciona separador de milhar
            input.value = value;
        }

        $(document).ready(function () {

            $('.btn-detalhes').on('click', function () {
                const pedidoId = $(this).data('id'); // Obtém o ID do pedido

                // Faz uma requisição AJAX para buscar os detalhes do pedido
                $.ajax({
                    url: `/Recolhas/ObterDetalhes/${pedidoId}`, // Ajuste conforme sua rota/controller
                    type: 'GET',
                    success: function (data) {
                        // Preenche os campos do modal com os dados recebidos
                        $('#det-id').text(data.id);
                        $('#det-placa').text(data.placaVeiculo);
                        $('#det-modelo').text(data.modelo);
                        $('#det-clienteCarga').text(data.clienteCarga);
                        $('#det-enderecoCarga').text(data.enderecoCarga);
                        $('#det-clienteDescarga').text(data.clienteDescarga);
                        $('#det-enderecoDescarga').text(data.enderecoDescarga);
                        $('#det-tipo').text(data.tipoPedido);
                        $('#det-inf-carga').text(data.adicionalCarga);
                        $('#det-inf-descarga').text(data.adicionalDescarga);

                        // Exibe o modal
                        $('#modalDetalhes').modal('show');
                    },
                    error: function () {
                        alert('Erro ao carregar os detalhes do pedido.');
                    }
                });
            });

            // Exibe o modal ao clicar no botão "Play"
            $('.btn-play').on('click', function () {
                const pedidoId = $(this).data('id'); // Obtém o ID do pedido do botão Play
                $('#saveStart').data('pedido-id', pedidoId); // Armazena o ID do pedido no botão "Salvar"
                $('#modalRecolha').modal('show'); // Exibe o modal

            });

            $('.btn-stop').on('click', function () {
                const pedidoId = $(this).data('id'); // Obtém o ID do pedido do botão Stop
                $('#saveStop').data('pedido-id', pedidoId); // Armazena o ID do pedido no botão "Salvar"
                $('#modalEntrega').modal('show'); // Exibe o modal

            });

            $('#modalRecolha').on('shown.bs.modal', function () {
                const canvasRecMot = document.getElementById('signatureCanvasRecMotorista');
                const canvasRecCli = document.getElementById('signatureCanvasRecCliente');

                if (canvasRecMot) {
                    const signaturePadRecMot = new SignaturePad(canvasRecMot);
                    const signaturePadRecCli = new SignaturePad(canvasRecCli);

                    $('#saveStart').on('click', function () {
                        const assMotoristaRecolha = signaturePadRecMot.isEmpty() ? null : signaturePadRecMot.toDataURL();
                        const assClienteRecolha = signaturePadRecCli.isEmpty() ? null : signaturePadRecCli.toDataURL();

                        const pedidoId = $(this).data('pedido-id');
                        const kmInicial = parseFloat($('#kmInicial').val());
                        const combustivelInicial = parseInt($('#combustivelInicial').val());
                        const trianguloHomologado = parseInt($('#trianguloHomologado').val());
                        const coleteHomologado = parseInt($('#coleteHomologado').val());
                        const documentoVeiculo = parseInt($('#documentoVeiculo').val());
                        const documentoSeguro = parseInt($('#documentoSeguro').val());
                        const telPessoaCar = $('#telPessoaCar').val();
                        const nomePessoaCar = $('#nomePessoaCar').val();
                        const emailPessoaCar = $('#emailPessoaCar').val();

                        const observacaoCarga = $('#observacaoCarga').val();
                        const tempoEsperaCarga = $('#tempoEsperaCarga').val();

                        if (!pedidoId || !kmInicial || !combustivelInicial || !trianguloHomologado || !coleteHomologado || !documentoVeiculo || !documentoSeguro || !assMotoristaRecolha || !nomePessoaCar) {
                            alert("Por favor, preencha todos os campos obrigatórios.");
                            return;
                        }

                        // Coletar as avarias e garantir que a lista não esteja vazia
                        let avarias = [];
                        document.querySelectorAll(".marker").forEach(marker => {
                            let select = marker.querySelector("select");
                            if (select && select.value) {
                                avarias.push({
                                    tipoAvaria: select.value,
                                    x: parseInt(marker.style.left),  // Obtendo a posição X
                                    y: parseInt(marker.style.top)   // Obtendo a posição Y
                                });
                            }
                        });


                        const formData = new FormData();
                        formData.append('PedidoId', pedidoId);
                        formData.append('KmInicial', kmInicial);
                        formData.append('CombustivelInicial', combustivelInicial);
                        formData.append('TrianguloHomologado', trianguloHomologado);
                        formData.append('ColeteHomologado', coleteHomologado);
                        formData.append('DocumentoVeiculo', documentoVeiculo);
                        formData.append('DocumentoSeguro', documentoSeguro);
                        formData.append('AssMotoristaRecolha', assMotoristaRecolha);
                        formData.append('AssClienteRecolha', assClienteRecolha);
                        formData.append('ObservacaoCarga', observacaoCarga);
                        formData.append('TempoEsperaCarga', tempoEsperaCarga);
                        formData.append('Avarias', JSON.stringify(avarias));
                        formData.append('Avarias', JSON.stringify(avarias));

                        formData.append('NomePessoaCar', nomePessoaCar);
                        formData.append('TelPessoaCar', telPessoaCar);
                        formData.append('EmailPessoaCar', emailPessoaCar);



                        fetch('/Recolhas/Start', {
                            method: 'POST',
                            body: formData
                        })
                            .then(response => response.json())
                            .then(data => {
                                alert(data.message || "Operação concluída com sucesso!");
                                $('#modalRecolha').modal('hide');
                                location.reload();
                            })
                            .catch(error => {
                                console.error("Erro ao registrar início da recolha:", error);
                                alert(`Erro ao registrar início da recolha: ${error.message}`);
                            });

                    });
                }
            });

            $('#modalEntrega').on('shown.bs.modal', function () {

                const canvasEntMot = document.getElementById('signatureCanvasEntMotorista');
                const canvasEntCli = document.getElementById('signatureCanvasEntCliente');

                if (canvasEntMot) {
                    const signaturePadEntMot = new SignaturePad(canvasEntMot);
                    const signaturePadEntCli = new SignaturePad(canvasEntCli);

                    $('#saveStop').on('click', function () {
                        const assMotoristaEntrega = signaturePadEntMot.isEmpty() ? null : signaturePadEntMot.toDataURL();
                        const assClienteEntrega = signaturePadEntCli.isEmpty() ? null : signaturePadEntCli.toDataURL();

                        const pedidoId = $(this).data('pedido-id');

                        // Faz a requisição AJAX para obter os detalhes, incluindo a KmInicial
                        $.ajax({
                            url: `/Recolhas/ObterDetalhes/${pedidoId}`,
                            type: 'GET',
                            success: function (data) {
                                console.log("Resposta da API:", data); // Loga o resultado no console

                                if (data && data.kmInicial !== undefined) {
                                    const kmInicial = data.kmInicial;
                                    console.log("kmInicial:", kmInicial); // Agora o log deve exibir o valor correto
                                    $('#kmInicial').val(kmInicial); // Atualiza o campo de input

                                    // Agora podemos usar a variável kmInicial corretamente
                                    processarEntrega(kmInicial, pedidoId, assMotoristaEntrega, assClienteEntrega);
                                } else {
                                    console.log("Erro: kmInicial não está definido na resposta da API.");
                                }
                            },
                            error: function () {
                                alert('Erro ao carregar os detalhes do pedido.');
                            }
                        });
                    });

                    function processarEntrega(kmInicial, pedidoId, assMotoristaEntrega, assClienteEntrega) {
                        const kmFinal = parseFloat($('#kmFinal').val());
                        const combustivelFinal = parseInt($('#combustivelFinal').val());

                        const observacaoDescarga = $('#observacaoDescarga').val();
                        const tempoEsperaDescarga = $('#tempoEsperaDescarga').val();

                        const telPessoaDes = $('#telPessoaDes').val();
                        const nomePessoaDes = $('#nomePessoaDes').val();
                        const emailPessoaDes = $('#emailPessoaDes').val();

                        console.log("kmInicial:", kmInicial);
                        console.log("kmFinal:", kmFinal);

                        if (isNaN(kmFinal) || isNaN(kmInicial)) {
                            alert("Os valores de KM não são válidos.");
                            return;
                        }

                        if (kmFinal <= kmInicial) {
                            alert(`O KM Final (${kmFinal}) não pode ser menor ou igual ao KM Inicial (${kmInicial}).`);
                            return;
                        }

                        if (!pedidoId || !kmFinal || !assMotoristaEntrega || !nomePessoaDes || !combustivelFinal) {
                            alert("Por favor, preencha todos os campos obrigatórios.");
                            return;
                        }

                        console.log("TempoEsperaDescarga:", tempoEsperaDescarga);

                        const formData = new FormData();
                        formData.append('PedidoId', pedidoId);
                        formData.append('KmFinal', kmFinal);
                        formData.append('CombustivelFinal', combustivelFinal);
                        formData.append('AssMotoristaEntrega', assMotoristaEntrega);
                        formData.append('AssClienteEntrega', assClienteEntrega);
                        formData.append('ObservacaoDescarga', observacaoDescarga);
                        formData.append('TempoEsperaDescarga', tempoEsperaDescarga);
                        formData.append('NomePessoaDes', nomePessoaDes);
                        formData.append('TelPessoaDes', telPessoaDes);
                        formData.append('EmailPessoaDes', emailPessoaDes);


                        fetch('/Recolhas/Stop', {
                            method: 'POST',
                            body: formData
                        })
                            .then(response => response.text())
                            .then(text => {
                                try {
                                    const data = JSON.parse(text);
                                    alert(data.message || "Operação concluída com sucesso!");
                                } catch (e) {
                                    alert(`Erro ao registrar finalização da entrega (Script): ${text}`);
                                }
                                $('#modalEntrega').modal('hide');
                                location.reload();
                            })
                            .catch(error => {
                                alert(`Erro ao registrar finalização da entrega (Script): ${error.message}`);
                            });
                    }
                }
            });



            $('#modalDetalhes').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Botão que acionou o modal
                var pedidoId = $(this).data('id');

                // Verifica no console se o ID está correto
                console.log("ID do Pedido:", pedidoId); // Aqui vai verificar se o ID está correto


                // Atualiza o botão de edição com o link correto
                if (pedidoId) {
                    $('#btn-editar').attr('href', '/Pedidos/Edit/' + pedidoId); // Somente passa o ID
                } else {
                    console.error("Erro: ID do pedido não encontrado!");
                    $('#btn-editar').attr('href', '#'); // Evita erro de navegação
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            var photoModal = new bootstrap.Modal(document.getElementById('photoModal'));
            var fotosCapturadas = new Set(); // Armazena os tipos de foto já capturados

            $('.btn-photo').on('click', function () {
                var pedidoId = $(this).data('id');
                $('#pedidoId').val(pedidoId);
                photoModal.show();

                $('#photoTypeSelection').show();
                $('#photoPreview').hide();

                atualizarCheckFotos();
            });

            $('#photoModal').on('hidden.bs.modal', function () {
                stopCamera();
            });

            $('#photoType').on('change', function () {
                if ($(this).val()) {
                    $('#cameraContainer').show();
                }
            });

            $('#galleryButton').on('click', function () {
                $('#galleryInput').click();
            });

            $('#galleryInput').on('change', function (event) {
                var file = event.target.files[0];
                handleFileSelection(file);
            });

            function handleFileSelection(file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var imgData = e.target.result;
                    $('#photoPreview').html('<img src="' + imgData + '" class="img-fluid mt-2">').show();
                    $('#video').hide();
                    enviarImagemParaServidor(imgData);
                };
                reader.readAsDataURL(file);
            }

            function enviarImagemParaServidor(imgData) {

                console.log("enviarImagemParaServidor");
                var pedidoId = $('#pedidoId').val();
                var tipoFotoVeiculo = $('#photoType').val();

                if (!tipoFotoVeiculo) {
                    alert('Por favor, selecione o tipo de foto!');
                    return;
                }

                var formData = new FormData();
                formData.append('pedidoId', pedidoId);
                formData.append('tipoFotoVeiculo', tipoFotoVeiculo);
                formData.append('imageData', imgData);

                console.log("Enviando dados para o servidor...", formData);

                $.ajax({
                    url: '/Recolhas/SalvarFotoPedido',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log("✅ Resposta do servidor:", response);
                        alert('Foto salva com sucesso!');

                        fotosCapturadas.add(tipoFotoVeiculo); // Adiciona ao conjunto de fotos capturadas
                        atualizarCheckFotos();

                        $('#photoType').val('');
                        $('#photoTypeSelection').show();
                        $('#photoPreview').hide();
                    },
                    error: function (xhr, status, error) {
                        console.error("❌ Erro ao salvar a foto!", xhr);
                        console.error("🔍 Status:", status);
                        console.error("⚠️ Detalhes:", error);

                        alert('Erro ao salvar a foto!', error);
                    }
                });
            }

            function atualizarCheckFotos() {
                $('#photoType option').each(function () {
                    var tipo = $(this).attr('data-original-text'); // Recupera o nome original
                    if (!tipo) {
                        tipo = $(this).text();
                        $(this).attr('data-original-text', tipo); // Salva o nome original no atributo
                    }

                    if (fotosCapturadas.has($(this).val())) {
                        $(this).text(tipo + ' ✅'); // Adiciona o check ao lado
                    } else {
                        $(this).text(tipo); // Mantém o nome original
                    }
                });
            }
        });
    </script>

    <script>

        $('#photoModal').on('shown.bs.modal', function () {
            var pedidoId = $('#pedidoId').val();

            $.ajax({
                url: "/Recolhas/ObterPedido",
                type: "GET",
                data: { pedidoId: pedidoId },
                success: function (data) {
                    console.log("Dados retornados do controlador:", data);
                    if (data.erro) {
                        alert(data.erro);
                        return;
                    }

                    var photoTypeSelect = $("#photoType");
                    photoTypeSelect.empty(); // Limpa as opções

                    photoTypeSelect.append('<option value="">-- Selecione --</option>');

                    // Use o booleano retornado pelo backend
                    if (data.isEstacionamento) {
                        console.log("Adicionando opção 'Local de Estacionamento'");
                        photoTypeSelect.append('<option value="11">Local de Estacionamento</option>');
                    } else {
                        var options = [
                            { value: "1", text: "Roda Dianteira Direita" },
                            { value: "2", text: "Roda Dianteira Esquerda" },
                            { value: "3", text: "Roda Traseira Direita" },
                            { value: "4", text: "Roda Traseira Esquerda" },
                            { value: "5", text: "Capô Dianteiro" },
                            { value: "6", text: "Capô Traseiro Aberto" },
                            { value: "7", text: "Capô Traseiro Fechado" },
                            { value: "10", text: "Diversos" }
                        ];

                        options.forEach(function (opt) {
                            photoTypeSelect.append(`<option value="${opt.value}">${opt.text}</option>`);
                        });
                    }
                },
                error: function () {
                    alert("Erro ao buscar os detalhes do pedido.");
                }
            });
        });


    </script>

}








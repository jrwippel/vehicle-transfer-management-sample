@model IEnumerable<WebAppSystemsTransp.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<style>
    .order-row {
        border-radius: 8px; /* Bordas arredondadas */
        box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1); /* Sombra leve */
        margin-bottom: 10px; /* Espaço entre linhas */
        padding: 10px; /* Espaçamento interno */
        display: flex; /* Layout flexível */
        flex-direction: column; /* Organizar itens em coluna */
        position: relative; /* Para posicionamento da matrícula e status */
    }

    /* Cores para o fundo dos cartões */
    .status-iniciado {
        background-color: #fff9db; /* Amarelo suave */
    }

    .status-nao-iniciado {
        background-color: #ffe5e9; /* Pink suave */
    }

    .status-finalizado {
        background-color: #dfffe0; /* Verde suave */
    }

    /* Estilo para matrícula e status */
    .vehicle-matricula, .status-field {
        position: absolute;
        right: 10px;
        color: #6c757d; /* Cinza */
        font-weight: bold;
        font-size: 12px;
    }

    .vehicle-matricula {
        top: 10px; /* Alinhado no topo do cartão */
    }

    .status-field {
        top: 30px; /* Logo abaixo da matrícula */
    }

    .order-id {
        font-weight: bold;
        color: #343a40; /* Texto escuro para contraste */
        margin-bottom: 5px;
    }

    .client-info {
        font-size: 14px;
        line-height: 1.5;
    }
</style>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">Lista de Pedidos</h4>
            <a asp-action="Create" asp-controller="Pedidos" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Novo Pedido
            </a>
        </div>
        <hr />
        <div>
            @foreach (var item in Model)
            {
                string rowClass = "status-nao-iniciado"; // Default: Não Iniciado (vermelho suave)
                string statusText = "Não Iniciado";

                if (item.HoraInicio.HasValue && !item.HoraFinal.HasValue)
                {
                    rowClass = "status-iniciado"; // Iniciado (amarelo suave)
                    statusText = "Iniciado";
                }
                else if (item.HoraInicio.HasValue && item.HoraFinal.HasValue)
                {
                    rowClass = "status-finalizado"; // Finalizado (verde suave)
                    statusText = "Finalizado";
                }

                <div class="order-row @rowClass">
                    <a asp-action="Details" asp-route-id="@item.Id" style="text-decoration: none; color: inherit;">
                        <!-- Número do Pedido -->
                        <div class="order-id">
                            Pedido ID: @Html.DisplayFor(modelItem => item.Id)
                        </div>
                        <!-- Matrícula do veículo -->
                        <div class="vehicle-matricula">
                            Matrícula: @Html.DisplayFor(modelItem => item.Veiculo.Matricula)
                        </div>
                        <!-- Status do veículo -->
                        <div class="status-field">
                            Status: @statusText
                        </div>
                        <!-- Informações dos clientes -->
                        <div class="client-info">
                            <p><strong>Cliente Carga:</strong> @Html.DisplayFor(modelItem => item.ClienteCarga.Nome)</p>
                            <p><strong>Cliente Descarga:</strong> @Html.DisplayFor(modelItem => item.ClienteDescarga.Nome)</p>
                        </div>
                    </a>

                    <!-- Ícone da lixeira -->
                    <div class="d-flex justify-content-end mt-2">
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger" title="Excluir Pedido">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

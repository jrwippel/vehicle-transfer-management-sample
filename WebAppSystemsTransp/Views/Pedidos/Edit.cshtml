@model WebAppSystemsTransp.Models.Pedido
@using WebAppSystemsTransp.Models.Enums

@{
    ViewData["Title"] = "Edição";
}

<h1>Alteração</h1>

<h4>Usuários</h4>
<hr />
<div class="card">
   <div class="card-body">
        <form asp-action="Edit">           

            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="VeiculoId" class="control-label">Veiculo</label>
                <select asp-for="VeiculoId" class="form-control" asp-items="ViewBag.Veiculos">
                    <option value="">Selecione um Cliente</option>
                </select>
                <span asp-validation-for="ClienteCargaId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ClienteCargaId" class="control-label">Cliente Carga</label>
                <select asp-for="ClienteCargaId" class="form-control" asp-items="ViewBag.Clientes">
                    <option value="">Selecione um Cliente</option>
                </select>
                <span asp-validation-for="ClienteCargaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClienteDescargaId" class="control-label">Cliente Descarga</label>
                <select asp-for="ClienteDescargaId" class="form-control" asp-items="ViewBag.Clientes">
                    <option value="">Selecione um Cliente</option>
                </select>
                <span asp-validation-for="ClienteDescargaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DataPretendida" class="control-label"></label>
                <input asp-for="DataPretendida" class="form-control" />
                <span asp-validation-for="DataPretendida" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdicionalCarga" class="control-label"></label>
                <input asp-for="AdicionalCarga" class="form-control" />
                <span asp-validation-for="AdicionalCarga" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdicionalDescarga" class="control-label"></label>
                <input asp-for="AdicionalDescarga" class="form-control" />
                <span asp-validation-for="AdicionalDescarga" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TipoPedido" class="control-label"></label>
                <select asp-for="TipoPedido" class="form-control">
                    <option value="">Selecione um Tipo de Pedido</option>
                    @if (ViewBag.TipoPedidoOptions != null)
                    {
                        foreach (var tipo in ViewBag.TipoPedidoOptions as List<TipoPedidoEnum>)
                        {
                            <option value="@tipo">@tipo.ToString()</option>
                        }
                    }
                </select>
                <span asp-validation-for="TipoPedido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MotoristaId" class="control-label">Motorista</label>
                <select asp-for="MotoristaId" class="form-control" asp-items="ViewBag.Motoristas">
                    <option value="">Selecione um Motorista</option>
                </select>
                <span asp-validation-for="MotoristaId" class="text-danger"></span>
            </div>      
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Alterar</button>
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>        
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


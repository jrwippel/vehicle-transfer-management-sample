                    <span class="d-block">Home</span>
                </a>
            </div>
        </li>

        @if (Model.Perfil == ProfileEnum.Admin)
        {
            <!--
            <li class="nav-item" title="Configurações">
                <div class="text-center">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Importacao" asp-action="Index">
                        <i class="fas fa-users fa-2x mb-2 d-block border rounded p-2" data-toggle="tooltip" title="Importaçao"></i>
                        <span class="d-block">Importacao</span>
                    </a>
                </div>
            </li>

            -->

            <li class="nav-item" title="Usuários">
                <div class="text-center">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Attorneys" asp-action="Index">
                        <i class="fas fa-users fa-2x mb-2 d-block border rounded p-2" data-toggle="tooltip" title="Usuários"></i>
                        <span class="d-block">Usuários</span>
                    </a>
                </div>
            </li>
            <li class="nav-item" title="Marcas">
                <div class="text-center">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Marcas" asp-action="Index">
